DATABASE_URL=postgresql+psycopg://osmio:osmio@db:5432/osmio
CORS_ORIGINS=http://localhost:3000

# Set to "production" outside local dev. The app refuses to boot in any non-development
# environment while JWT_SECRET is still the built-in default.
ENVIRONMENT=development

# Auth: use a long random value in production (e.g. `openssl rand -hex 32`).
JWT_SECRET=dev-secret-change-me

# Cloudflare Stream
CF_ACCOUNT_ID=
CF_STREAM_TOKEN=

# Groq (transcription)
GROQ_API_KEY=
